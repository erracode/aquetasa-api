# Cloudflare D1 Database ID
D1_DATABASE_ID=bce4b7a9-e714-492d-a031-e417f956af04

# Cloudflare KV Namespace ID
KV_NAMESPACE_ID=741322d66a47411b9f44929991e0bf2c

# API Key para endpoints de cron (usar `wrangler secret put CRON_API_KEY` en prod)
# Local: copiar .env.example a .env y poner la key acá
CRON_API_KEY=tu-api-key-segura-aqui

# URL fallback para tasas BCV
DOLAR_API_URL=https://ve.dolarapi.com/v1/dolares

# Rate limit por minuto
RATE_LIMIT_PER_MINUTE=30

# Cache TTL en segundos
CACHE_TTL_SECONDS=300

# CORS origins (comma-separated)
ALLOWED_ORIGINS=https://aquetasa.app
